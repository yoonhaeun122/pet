
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>급여 관리 | PetCare</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
    <aside class="sidebar">
        <h1>🐾 PetCare<span>.</span></h1>
        <p class="label">MENU</p>
        <a href="/">⌂　 대시보드</a>
        <a href="/#pet">♡　 반려동물 관리</a>
        <a href="/health/<%= pet.id %>">✚　 건강 기록</a>
        <a class="active" href="#">♧　 급여 기록</a>
        <a href="/#weight">⌁　 몸무게 관리</a>
    </aside>

    <main>
        <header>
            <div>
                <small>FEEDING MANAGEMENT</small>
                <h2><%= pet.name %>의 급여 기록 🍚</h2>
            </div>
            <div class="avatar">🐱</div>
        </header>

        <section class="white-card">
            <small>NEW FEEDING RECORD</small>
            <h3>오늘의 식사 기록하기 🌿</h3>

            <form action="/feeding/<%= pet.id %>" method="POST">
                <label>사료 이름</label>
                <input type="text" name="food_name"
                    placeholder="예: 로얄캐닌 인도어" required>

                <label>급여량</label>
                <input type="number" name="amount"
                    placeholder="예: 50" min="0.01" step="0.01">

                <label>단위</label>
                <select name="unit">
                    <option value="g">g</option>
                    <option value="ml">ml</option>
                </select>

                <button type="submit" class="button">
                    급여 기록 저장하기 →
                </button>
            </form>
        </section>

        <section>
            <div class="heading">
                <div>
                    <small>FEEDING HISTORY</small>
                    <h2>급여 기록 목록</h2>
                </div>
            </div>

            <% if (records.length > 0) { %>
                <% records.forEach(record => { %>
                    <div class="pet-card">
                        <div class="pet-picture">🍚</div>
                        <div>
                            <small>FEEDING RECORD</small>
                            <h3><%= record.food_name %></h3>
                            <p>
                                급여량:
                                <%= record.amount || '미입력' %>
                                <%= record.amount ? (record.unit || 'g') : '' %>
                                <br>
                                급여 시간:
                                <%= new Date(record.fed_at)
                                    .toLocaleString('ko-KR') %>
                            </p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="white-card">
                    아직 등록된 급여 기록이 없습니다.
                </div>
            <% } %>
        </section>

        <footer>🐾 PetCare <span>소중한 가족의 건강한 일상을 함께합니다.</span></footer>
    </main>
</div>
</body>
</html>

