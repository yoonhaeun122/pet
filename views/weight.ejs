
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>몸무게 관리 | PetCare</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="layout">
    <aside class="sidebar">
        <h1>🐾 PetCare<span>.</span></h1>
        <p class="label">MENU</p>
        <a href="/">⌂　 대시보드</a>
        <a href="/#pet">♡　 반려동물 관리</a>
        <a href="/health/<%= pet.id %>">✚　 건강 기록</a>
        <a href="/feeding/<%= pet.id %>">♧　 급여 기록</a>
        <a class="active" href="#">⌁　 몸무게 관리</a>
    </aside>

    <main>
        <header>
            <div>
                <small>WEIGHT MANAGEMENT</small>
                <h2><%= pet.name %>의 몸무게 관리 ⚖️</h2>
            </div>
            <div class="avatar">🐱</div>
        </header>

        <section class="white-card">
            <small>NEW WEIGHT RECORD</small>
            <h3>몸무게 기록하기 🌱</h3>

            <form action="/weight/<%= pet.id %>" method="POST">
                <label>몸무게 (kg)</label>
                <input type="number" name="weight"
                    placeholder="예: 5.20"
                    min="0.01" max="300" step="0.01" required>

                <label>측정 날짜</label>
                <input type="date" name="measured_at" required>

                <button type="submit" class="button">
                    몸무게 저장하기 →
                </button>
            </form>
        </section>

        <section>
            <div class="heading">
                <div>
                    <small>WEIGHT HISTORY</small>
                    <h2>몸무게 변화 기록</h2>
                </div>
            </div>

            <% if (records.length > 0) { %>
                <% records.forEach(record => { %>
                    <div class="pet-card">
                        <div class="pet-picture">⚖️</div>
                        <div>
                            <small>WEIGHT RECORD</small>
                            <h3><%= Number(record.weight).toFixed(2) %> kg</h3>
                            <p>
                                측정 날짜:
                                <%= new Date(record.measured_at)
                                    .toLocaleDateString('ko-KR') %>
                            </p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="white-card">
                    아직 등록된 몸무게 기록이 없습니다.
                </div>
            <% } %>
        </section>

        <footer>🐾 PetCare <span>소중한 가족의 건강한 일상을 함께합니다.</span></footer>
    </main>
</div>
</body>
</html>

